{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReminderAgentResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "task",
    "datetime",
    "snooze_minutes",
    "requires_clarification",
    "missing_fields",
    "clarification_question"
  ],
  "properties": {
    "intent": {"enum": ["create", "reschedule", "snooze", "unknown"]},
    "task": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
    "datetime": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"
    },
    "snooze_minutes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1440},
    "requires_clarification": {"type": "boolean"},
    "missing_fields": {
      "type": "array",
      "items": {"enum": ["task", "date", "time"]},
      "uniqueItems": true
    },
    "clarification_question": {"type": ["string", "null"], "minLength": 1, "maxLength": 200}
  }
}
